generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model admin_users {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String    @unique @db.VarChar(100)
  password_hash String    @db.VarChar(255)
  name          String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  application_logs application_logs[]
  application_scores application_scores[]
}

model lowongan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique @db.VarChar(50)
  title        String   @db.VarChar(255)
  placement    String   @db.VarChar(255)
  qualification String
  period       String   @db.VarChar(20)
  is_active    Boolean  @default(true)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  applications applications[]

  @@index([is_active, sort_order])
}

model application_stages {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(100)
  order        Int      @default(0)
  is_terminal  Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  applications      applications[]
  application_scores application_scores[]
  logs_from         application_logs[] @relation("log_from")
  logs_to           application_logs[] @relation("log_to")

  @@index([order])
}

model applications {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registration_code String  @unique @db.VarChar(50)
  lowongan_id     String    @db.Uuid
  stage_id        String    @db.Uuid
  periode         String    @db.VarChar(20)

  // Data diri
  full_name       String    @db.VarChar(255)
  nik             String    @db.VarChar(20)
  kk_number       String    @db.VarChar(20)
  mother_name     String    @db.VarChar(255)
  phone1          String    @db.VarChar(30)
  phone2          String?   @db.VarChar(30)
  birth_place     String    @db.VarChar(255)
  birth_date      DateTime  @db.Date
  gender          String    @db.VarChar(20)
  info_source     String    @db.VarChar(50)
  disability      String    @db.VarChar(50)
  worked_yazaki   Boolean   @default(false)
  marital_status  String    @db.VarChar(20)
  email           String    @db.VarChar(255)
  religion        String    @db.VarChar(50)

  // Pendidikan
  education       String    @db.VarChar(50)
  major           String    @db.VarChar(255)
  school_name     String    @db.VarChar(255)
  gpa             String    @db.VarChar(50)

  // Alamat
  province        String    @db.VarChar(255)
  regency         String    @db.VarChar(255)
  district        String    @db.VarChar(255)
  village         String    @db.VarChar(255)
  postal_code     String    @db.VarChar(10)
  address         String

  // Dokumen
  cv_url          String?
  cv_public_id    String?
  ijazah_url      String?
  ijazah_public_id String?
  foto_url        String?
  foto_public_id  String?

  notes           String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  lowongan        lowongan  @relation(fields: [lowongan_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stage           application_stages @relation(fields: [stage_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  experiences     pengalaman_kerja[]
  scores          application_scores[]
  logs            application_logs[]

  @@index([lowongan_id])
  @@index([stage_id])
  @@index([created_at(sort: Desc)])
}

model pengalaman_kerja {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id String        @db.Uuid
  company_name   String        @db.VarChar(255)
  position       String        @db.VarChar(255)
  year_range     String?       @db.VarChar(50)
  description    String?
  created_at     DateTime      @default(now()) @db.Timestamptz(6)

  application applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([application_id])
}

model application_scores {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id String    @db.Uuid
  stage_id       String    @db.Uuid
  score          Decimal   @db.Decimal(5, 2)
  notes          String?
  created_by     String?   @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  application applications       @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stage       application_stages @relation(fields: [stage_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  admin       admin_users?       @relation(fields: [created_by], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([application_id, stage_id])
  @@index([stage_id])
}

model application_logs {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id String    @db.Uuid
  from_stage_id  String?   @db.Uuid
  to_stage_id    String    @db.Uuid
  changed_by     String?   @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  application applications       @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  from_stage  application_stages? @relation("log_from", fields: [from_stage_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  to_stage    application_stages  @relation("log_to", fields: [to_stage_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  admin       admin_users?        @relation(fields: [changed_by], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([application_id])
}
